[sub_resource type="Shader" id="Shader_507ja"]
code = "shader_type canvas_item;

render_mode unshaded, blend_add;

instance uniform float impact_progress: hint_range(0.0, 1.0) = 0.0;
instance uniform float impact_x: hint_range(0.0, 1.0) = 0.5;

instance uniform vec4 impact_color : source_color =
	vec4(0.12, 0.32, 1.0, 1.0);

void fragment() {

	vec2 uv = UV;

	// --------------------------------------------------
	// CENTER THE EFFECT
	// --------------------------------------------------

	vec2 p = vec2(
		uv.x,
		uv.y
	);

	vec2 center = vec2(
		impact_x,
		0.90
	);

	vec2 delta = p - center;

	// Compress vertical distance.
	// This makes the aura feel like it is sitting
	// ON the platform rather than being a circular
	// explosion floating in space.
	delta.y *= 2.8;

	float distance_from_impact = length(delta);


	// --------------------------------------------------
	// IMPACT TIMING
	// --------------------------------------------------

	float progress = impact_progress;

	float appear = smoothstep(
		0.0,
		0.10,
		progress
	);

	float fade = 1.0 - smoothstep(
		0.45,
		1.0,
		progress
	);


	// --------------------------------------------------
	// MAIN SOFT AURA
	// --------------------------------------------------

	float aura_radius = mix(
		0.025,
		0.22,
		smoothstep(
			0.0,
			0.45,
			progress
		)
	);

	float aura = 1.0 - smoothstep(
		0.0,
		0.055,
		abs(
			distance_from_impact -
			aura_radius
		)
	);

	aura *= 0.55;


	// --------------------------------------------------
	// SECONDARY SOFT AURA
	// --------------------------------------------------

	float secondary_radius = mix(
		0.04,
		0.32,
		smoothstep(
			0.08,
			0.60,
			progress
		)
	);

	float secondary = 1.0 - smoothstep(
		0.0,
		0.035,
		abs(
			distance_from_impact -
			secondary_radius
		)
	);

	secondary *= 0.18;


	// --------------------------------------------------
	// IMPACT CORE
	// --------------------------------------------------

	float core = 1.0 - smoothstep(
		0.0,
		0.045,
		distance_from_impact
	);

	core *= 1.0 - smoothstep(
		0.05,
		0.35,
		progress
	);


	// --------------------------------------------------
	// COMBINE
	// --------------------------------------------------

	float intensity =
		(aura +
		secondary +
		core) *
		appear *
		fade;

	COLOR = vec4(
		impact_color.rgb * intensity,
		intensity
	);
}"

